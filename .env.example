# Copy to .env.local. Never commit .env.local.

# --- Database ------------------------------------------------------------------
# Local: the docker-compose Postgres (port 5433). Vercel: the Neon pooled connection string.
DATABASE_URL=postgres://atliq:atliq@localhost:5433/atliq

# The dataset's "today". All live/expired date maths uses this.
APP_TODAY=2026-09-28

# --- AI provider ---------------------------------------------------------------
# anthropic | groq. If unset: Anthropic when ANTHROPIC_API_KEY is set, otherwise Groq when GROQ_API_KEY is set.
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

GROQ_API_KEY=
# Structured outputs are strict (schema-enforced) on openai/gpt-oss-120b, openai/gpt-oss-20b and qwen/qwen3.8-27b;
# other Groq models fall back to JSON mode, validated by the app.
GROQ_MODEL=openai/gpt-oss-120b

# Reasoning effort: low | medium | high (Anthropic also accepts xhigh | max). Default high.
AI_EFFORT=high
# Largest single prompt in estimated tokens; longer contracts are split into clause groups.
# Defaults: Anthropic 150000, Groq 6000.
AI_MAX_INPUT_TOKENS=
